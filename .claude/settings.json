{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": false,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh repo create *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ruleset *)",
      "Bash(gh auth *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * HEAD:main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git tag *)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform import*)",
      "Bash(tofu apply*)",
      "Bash(tofu destroy*)",
      "Bash(oci *)",
      "Bash(sudo *)",
      "Bash(env)",
      "Bash(printenv*)",
      "Read(~/.config/gh/**)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(gh api *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(pip install *)",
      "Bash(uv tool install *)",
      "Bash(npm install *)",
      "WebFetch"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(rg *)",
      "Bash(fd *)"
    ]
  }
}
