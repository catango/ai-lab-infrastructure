#!/usr/bin/env python3
"""facts: gather facts about the operator machine as yes/no, counts, sizes, and versions (CR-18 design section 5.1).

Scope host reads /proc and /etc, `git --version`, and a small local state file. Scope github reads repository settings,
rulesets, and security features with GET calls only, without a token unless --use-token asks for T3. Without --apply a scope
lists its checks and changes nothing. With --apply the host scope writes only its local state files (mode 600) in the
operator's home, and the github scope writes nothing. --privileged runs a fixed list of read-only root commands, each asking for
the sudo password. Scope oci reads limits, usage, and resource counts with list, get, and inspect OCI CLI calls only, with the lab
operator VM's instance principal or (--oci-auth instance_obo_user) the Cloud Shell session; it never handles an OCI credential, and
with --apply it writes raw answers only to a private directory in the operator's home.
"""
import os
import sys

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "lib"))

from operator_lib import credentials, download, exitcodes, github, githubfacts, hostfacts, modes, ocifacts, process, rawdir, release, sanitize  # noqa: E402

ROOT = os.path.normpath(os.path.join(HERE, "..", ".."))
MANIFEST = os.path.join(ROOT, "toolchain", "manifest.toml")
DESCRIPTION = "Gather facts about this operator machine (dry run by default; --apply runs the checks)."

# The fixed list of read-only root commands of --privileged (design section 5.1, R4). Nothing else is ever run with sudo.
PRIVILEGED = (
    ("sshd", "-T"),
    ("nft", "list", "ruleset"),
    ("find", "/etc/sudoers.d", "-maxdepth", "1", "-type", "f"),
)
PROBE = ("sudo", "-n", "true")
ALLOW_EXACT = frozenset({("sudo",) + command for command in PRIVILEGED} | {PROBE})

MANUAL_LINES = (
    "manual: provider firewall and access rules (read them in the provider's console)",
    "manual: the SSH path from Z0 to this machine (test it from the Windows laptop)",
    "manual: corporate approval for this machine and its network use",
)
OCI_MANUAL_LINES = (
    "manual: Always Free limits for alarms and Notifications, public IPv4 limits, and IP retention on stop and replacement are not readable here (VO-12, VO-13): read them in the Console",
    "manual: a value shown as unknown was denied, failed, or had another page: check the access of the principal or session, then run again",
)
BANDWIDTH_CAP = 16 * 1024 * 1024
BANDWIDTH_TIMEOUT = 60


def add_arguments(parser):
    parser.add_argument("--scope", choices=["host", "github", "oci"], default="host", help="the facts to gather")
    parser.add_argument("--oci-auth", choices=ocifacts.AUTH_CHOICES, default=None,
                        help="oci scope: how the OCI CLI authenticates: instance_principal (default, the lab operator VM) or instance_obo_user (Cloud Shell)")
    parser.add_argument("--owner", help="github scope: the account that owns the repositories")
    parser.add_argument("--repo", action="append", help="github scope: a repository to read (repeatable)")
    parser.add_argument("--use-token", action="store_true", help="github scope: ask for T3 (read-only) to read what needs a token")
    parser.add_argument("--privileged", action="store_true", help="also run the fixed read-only root commands, each asking for the sudo password")
    parser.add_argument("--measure-bandwidth", action="store_true", help="time one manifest download and discard it")
    parser.add_argument("--write-allowlist", action="store_true", help="write the current egress address to the operator-local allowlist file")


def plan_lines(args):
    if args.scope == "oci":
        return ocifacts.plan_lines(args.oci_auth or ocifacts.DEFAULT_AUTH)
    if args.scope == "github":
        lines = ["would: read, with GET calls only and " + ("with T3 from a prompt" if args.use_token else "without a token") + ":"]
        for repo in args.repo:
            lines.extend(f"would: GET {path}" for path in githubfacts.get_paths(args.owner, repo))
        return lines
    lines = ["would: collect host facts (versions, memory, CPU, disk, time sync, account and sudo-group counts, listening port count, "
             "firewall service state, package count)",
             "would: record home persistence and egress stability in the local state file (mode 600)"]
    if args.measure_bandwidth:
        lines.append("would: download one manifest artifact once to time it, and discard it")
    if args.write_allowlist:
        lines.append("would: write the current egress address to the operator-local allowlist file (the address is not printed)")
    if args.privileged:
        for command in PRIVILEGED:
            lines.append("would: run with sudo, asking for the password: " + " ".join(command))
        lines.append("would: run " + " ".join(PROBE) + " (no password prompt)")
    return lines


def collect_privileged(runner):
    facts = {}
    outputs = {}
    for command in PRIVILEGED:
        try:
            result = runner(("sudo",) + command, allow_exact=ALLOW_EXACT, interactive=True, timeout=120)
            outputs[command] = result.stdout if result.returncode == 0 else None
        except (process.CommandMissing, process.CommandTimeout, process.PolicyViolation):
            outputs[command] = None
    facts.update(hostfacts.parse_sshd(outputs[PRIVILEGED[0]]))
    if outputs[PRIVILEGED[1]] is None:
        facts.update({"nft_tables": hostfacts.UNKNOWN, "nft_chains": hostfacts.UNKNOWN, "nft_input_policy_drop": hostfacts.UNKNOWN})
    else:
        facts.update(hostfacts.parse_nft(outputs[PRIVILEGED[1]]))
    facts["sudoers_d_files"] = hostfacts.UNKNOWN if outputs[PRIVILEGED[2]] is None else hostfacts.count_sudoers_d(outputs[PRIVILEGED[2]])
    try:
        probe = runner(PROBE, allow_exact=ALLOW_EXACT, timeout=30)
        facts["sudo_passwordless"] = hostfacts.yes_no(probe.returncode == 0)
    except (process.CommandMissing, process.CommandTimeout, process.PolicyViolation):
        facts["sudo_passwordless"] = hostfacts.UNKNOWN
    return facts


def measure_bandwidth(downloader, manifest):
    try:
        url = download.manifest_artifact_url(manifest)
        timing = downloader(url, max_bytes=BANDWIDTH_CAP, timeout=BANDWIDTH_TIMEOUT)
    except (download.DownloadError, ValueError):
        return hostfacts.UNKNOWN
    value = download.megabits_per_second(timing)
    return hostfacts.UNKNOWN if value is None else value


def check_arguments(args):
    """Cross-checks that argparse cannot do: the github scope needs an owner and repositories, and the host scope takes none."""
    problem = None
    if args.scope == "oci":
        if args.owner or args.repo or args.use_token or args.privileged or args.measure_bandwidth or args.write_allowlist:
            problem = "--scope oci takes only --oci-auth (the other options belong to the host and github scopes)"
    elif args.oci_auth:
        problem = "--oci-auth belongs to --scope oci"
    elif args.scope == "github":
        if not args.owner or not args.repo:
            problem = "--scope github needs --owner and at least one --repo"
        elif not github.valid_login(args.owner) or not all(github.valid_repo(r) for r in args.repo):
            problem = "--owner or --repo is not a valid GitHub name"
        elif args.privileged or args.measure_bandwidth or args.write_allowlist:
            problem = "--privileged, --measure-bandwidth, and --write-allowlist belong to the host scope"
    elif args.owner or args.repo or args.use_token:
        problem = "--owner, --repo, and --use-token belong to --scope github"
    if problem:
        print(f"facts: {problem}", file=sys.stderr)
        raise SystemExit(exitcodes.USAGE)


def run_github(args, mode, out, opener, getpass_fn):
    token = None
    if args.use_token:
        try:
            token = credentials.prompt_token("T3", getpass_fn=getpass_fn)
        except credentials.TokenError as error:
            out(f"refused: {error}")
            return exitcodes.FAILED
    client = githubfacts.client_for(token, opener=opener)
    for repo in args.repo:
        out(f"== facts (github): {repo} ==")
        for line in sanitize.summary_lines(githubfacts.collect(client, args.owner, repo)):
            out(line)
    out("== manual (off-host) ==")
    out("manual: facts that need a token stay unknown without --use-token; revoke T3 in the browser after the run")
    return exitcodes.OK


def run_oci(args, environ, out, runner):
    auth = args.oci_auth or ocifacts.DEFAULT_AUTH
    home = environ.get("HOME", "")
    if not home or not os.path.isabs(home):
        out("refused: HOME is not set to an absolute path")
        return exitcodes.FAILED
    try:
        env = ocifacts.forwarded_env(auth, environ)
    except ValueError as error:
        out(f"refused: {error}")
        return exitcodes.FAILED
    try:
        raw = rawdir.RawDir(os.path.join(home, ".local", "state", "operator", "oci-raw"), cap_bytes=ocifacts.RAW_CAP)
        raw.cleanup(ocifacts.RAW_CAP // 2)
    except (rawdir.RawDirError, OSError):
        raw = None
    try:
        collected, resolved = ocifacts.collect(runner, auth, env, raw)
    except process.CommandMissing:
        out("skipped: the oci command is not installed or not executable (it comes with the operator profile, or is part of Cloud Shell)")
        return exitcodes.SKIPPED
    except process.PolicyViolation:
        out("refused: an OCI call outside the read-only policy was blocked; nothing else was run")
        return exitcodes.FAILED
    out("== facts (oci) ==")
    for line in sanitize.summary_lines(collected):
        out(line)
    out("== manual (off-host) ==")
    for line in OCI_MANUAL_LINES:
        out(line)
    if not resolved:
        out("refused: the tenancy could not be read with this authentication; no limits or resources were read")
        return exitcodes.FAILED
    return exitcodes.OK


def main(argv=None, *, system=None, environ=None, out=print, require_release=release.require_release_commit,
         runner=process.run, downloader=download.timed_download, manifest=MANIFEST, opener=None, getpass_fn=credentials.getpass.getpass):
    mode, args = modes.parse_mode(sys.argv[1:] if argv is None else argv, "facts", DESCRIPTION, add_arguments)
    check_arguments(args)
    environ = os.environ if environ is None else environ
    require_release(ROOT, out=out)
    if mode.dry_run:
        for line in plan_lines(args):
            out(line)
        out("dry run: nothing was checked and nothing was written. Run again with --apply to gather the facts.")
        return exitcodes.OK
    if args.scope == "github":
        return run_github(args, mode, out, opener, getpass_fn)
    if args.scope == "oci":
        return run_oci(args, environ, out, runner)

    system = system or hostfacts.RealSystem()
    home = environ.get("HOME", "")
    if not home or not os.path.isabs(home):
        out("refused: HOME is not set to an absolute path")
        return exitcodes.FAILED
    address = hostfacts.egress_address(environ)
    if args.write_allowlist and address is None:
        out("refused: no client address is available (run this over SSH); nothing was written")
        return exitcodes.FAILED

    facts = hostfacts.collect_host(system, runner)
    state = hostfacts.State(hostfacts.state_dir(home))
    facts.update(state.record(system, address))
    if args.measure_bandwidth:
        facts["bandwidth_mbit"] = measure_bandwidth(downloader, manifest)
    if args.privileged:
        facts.update(collect_privileged(runner))
    state.save()
    if args.write_allowlist:
        facts["allowlist_entries"] = hostfacts.write_allowlist(home, address)

    out("== facts (host) ==")
    for line in sanitize.summary_lines(facts):
        out(line)
    out("== machine profile entry ==")
    for line in hostfacts.render_toml(hostfacts.profile_entry(system, facts)):
        out(line)
    out("== manual (off-host) ==")
    for line in MANUAL_LINES:
        out(line)
    return exitcodes.OK


if __name__ == "__main__":
    sys.exit(main())
