#!/usr/bin/env python3
"""pr-contract entry point. Run as: python3 -I scripts/pr-contract --repo OWNER/NAME --pr NUMBER

CI runs this file from a checkout of the base commit, so a PR cannot change the checker that
judges it. See docs/cr/CR-2/design.md section 6.
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from pr_contract.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
