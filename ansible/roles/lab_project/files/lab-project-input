#!/usr/bin/python3 -I
"""The project input channel of lab setup (CR-57 plan PR 8; PA-34, PA-A23, PA-A31; O-18, O-22; I-7; R-2).

Lab setup runs this as root, from the release clone of the lab admin. It never runs anything that belongs to a project. It reads
three files of a project and nothing else:

  toolchain/manifest.toml       the project's CI manifest ("the tools CI uses"); the root-owned engine installs its download tools
  toolchain/lab-packages.txt    the project's package list (Debian archive packages, one name per line)
  .claude/deny.platform.txt     the project's seeded deny entries (merged into the lab-wide list after the core entries)

They come from one of two places: an anonymous clone of a GitHub repository at a tag or a full commit SHA that is merged (reachable
from the default branch), or the AI user's own clone at a full commit SHA the user supplies (merged or not; git runs as the AI user and
root only reads the bytes). Either way the bytes are a tar of `git archive` for those three paths, and `extract_tar` accepts regular
files of those names only, so the project's own `scripts/toolchain` is never extracted and never run.

  lab-project-input stage --out DIR --core FILE [--repo URL --ref REF | --clone PATH --sha SHA] [--as-user NAME] [--recorded DIR]
      reads and checks the project, stages the files (mode 0600) in DIR, and prints one JSON object: the source, the package names,
      the merged lab-wide deny list, and the texts that lab setup records. A refusal prints nothing on stdout and stages nothing.
  lab-project-input packages --file FILE [--apply --reviewed DIGEST]
      prints every package name and version that apt would install for the list (dependencies included, Debian archive only); with
      --apply installs exactly that plan, and only when DIGEST is the plan_sha256 that a dry run printed.

Exit status: 0 done, 1 refused, 2 usage error. Standard library only; no network except the anonymous `git clone` over https.
"""
import argparse
import hashlib
import io
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import tomllib

MANIFEST_PATH = "toolchain/manifest.toml"
PACKAGES_PATH = "toolchain/lab-packages.txt"
DENY_PATH = ".claude/deny.platform.txt"
STAGED = {MANIFEST_PATH: "manifest.toml", PACKAGES_PATH: "packages.txt", DENY_PATH: "deny.platform.txt"}
PARENTS = {"toolchain", ".claude"}
MAX_FILE = 1 << 20
MAX_TAR = 4 << 20
MAX_PACKAGES = 200
GIT = "/usr/bin/git"
GIT_ENV = {"PATH": "/usr/bin:/bin", "LC_ALL": "C", "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_SYSTEM": "/dev/null",
           "GIT_CONFIG_NOSYSTEM": "1", "GIT_TERMINAL_PROMPT": "0", "GIT_ASKPASS": "/bin/false", "GIT_OPTIONAL_LOCKS": "0"}
APT_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C", "DEBIAN_FRONTEND": "noninteractive"}
URL = re.compile(r"https://github\.com/([A-Za-z0-9][A-Za-z0-9._-]{0,99})/([A-Za-z0-9._-]{1,100})")
TAG = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}")
SHA = re.compile(r"[0-9a-f]{40}")
PACKAGE = re.compile(r"[a-z0-9][a-z0-9.+-]{1,60}")
SOURCE_LINE = re.compile(r"(deb|deb-src|types:|uris:|suites:|components:|signed-by:)(\s|\[|$)", re.IGNORECASE)
DENY_ENTRY = re.compile(r"[A-Za-z][A-Za-z0-9_]*(\([^\x00-\x1f\x7f]{1,280}\))?")
INST = re.compile(r"^Inst (\S+)(?: \[[^\]]*\])? \((\S+) (.+?)(?: \[[^\]]+\])?\)")


class Refusal(Exception):
    """A refusal: the input is not acceptable. Nothing has been changed."""


# ------------------------------------------------------------------------------------------------------------ plain checks
def _lines(text):
    return [line.strip() for line in text.splitlines() if line.strip() and not line.lstrip().startswith("#")]


def parse_packages(text):
    """The package names of a project package list. A third-party apt source, a release or version pin, and anything but a plain
    Debian package name is refused (PA-34: Debian archive only)."""
    names = []
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        shown = line[:80]
        lowered = line.lower()
        if SOURCE_LINE.match(line) or "://" in line or lowered.startswith("ppa:") or "signed-by" in lowered:
            raise Refusal(f"package list line {number}: a third-party apt source is refused (Debian archive packages only): {shown}")
        if not PACKAGE.fullmatch(line) or line.endswith("-"):
            raise Refusal(f"package list line {number}: not a plain Debian package name (no release, version, or architecture): {shown}")
        if line in names:
            raise Refusal(f"package list line {number}: {line} is listed twice")
        names.append(line)
    if len(names) > MAX_PACKAGES:
        raise Refusal(f"the package list names {len(names)} packages; at most {MAX_PACKAGES} are accepted")
    return names


def parse_deny(text):
    """The entries of a deny list in file order (blank lines and # comments skipped); each must look like a permission rule."""
    entries = []
    for line in _lines(text):
        if len(line) > 300 or not DENY_ENTRY.fullmatch(line):
            raise Refusal(f"deny list: not a permission rule: {line[:80]!r}")
        entries.append(line)
    return entries


def merge_deny(core_text, project_text, repo_label, commit):
    """(text, entries, added): the core list byte for byte, then the project's entries that the core does not have, once each.

    A project file only adds (PA-A10): no core entry is dropped, reordered, or rewritten."""
    core = parse_deny(core_text)
    if not core:
        raise Refusal("the core deny list holds no entry")
    if len(set(core)) != len(core):
        raise Refusal("the core deny list names an entry twice")
    if project_text is None:
        return core_text, core, []
    added = []
    for entry in parse_deny(project_text):
        if entry not in core and entry not in added:
            added.append(entry)
    if not added:
        return core_text, core, []
    label = re.sub(r"[^A-Za-z0-9._/:-]", "?", repo_label or "the supplied clone")
    text = core_text + ("" if core_text.endswith("\n") else "\n")
    text += f"# project entries (deny.platform.txt of {label} at {(commit or '')[:12]})\n" + "\n".join(added) + "\n"
    return text, core + added, added


TOOL_HEADER = re.compile(r"^\s*\[\[?\s*tools\.([A-Za-z0-9_-]+)\s*(?:\.|\]\]?)")
ANY_HEADER = re.compile(r"^\s*\[")


def filter_manifest(text):
    """(manifest text for the engine or None, [(name, source)] left out). The project's CI manifest lists "the tools CI uses", which in a
    template-seeded project includes apt and pip tools. v1 installs the download tools only: apt entries belong to the package list, and
    a pip tool needs a lock file that is not one of the three paths read. The tables of those tools are cut out, and the result must
    parse to exactly the download tools of the original, or the layout is refused (one table per tool is the layout of the engine)."""
    try:
        raw = tomllib.loads(text)
    except tomllib.TOMLDecodeError:
        raise Refusal("the project manifest is not valid TOML") from None
    tools = raw.get("tools")
    if not isinstance(tools, dict) or not tools:
        raise Refusal("the project manifest has no tools")
    skipped = sorted((name, entry.get("source")) for name, entry in tools.items() if isinstance(entry, dict) and entry.get("source") != "download")
    if not skipped:
        return text, []
    drop = {name for name, _ in skipped}
    kept, dropping = [], False
    for line in text.splitlines(keepends=True):
        header = TOOL_HEADER.match(line)
        if header:
            dropping = header.group(1) in drop
        elif ANY_HEADER.match(line):
            dropping = False
        if not dropping:
            kept.append(line)
    filtered = "".join(kept)
    try:
        again = tomllib.loads(filtered)
    except tomllib.TOMLDecodeError:
        again = None
    expected = {name: entry for name, entry in tools.items() if name not in drop}
    if again is None or again.get("tools", {}) != expected or {k: v for k, v in again.items() if k != "tools"} != {k: v for k, v in raw.items() if k != "tools"}:
        raise Refusal("the project manifest cannot be reduced to its download tools (use one [tools.<name>] table per tool, as the engine does)")
    return (filtered if expected else None), skipped


# ------------------------------------------------------------------------------------------------------------ the archive
def _empty_tar():
    buffer = io.BytesIO()
    tarfile.open(fileobj=buffer, mode="w").close()
    return buffer.getvalue()


def extract_tar(data):
    """{staged name: text} from a tar of the three paths. Regular files of those names and the directories above them only."""
    if len(data) > MAX_TAR:
        raise Refusal("the archive of the project files is too large")
    try:
        archive = tarfile.open(fileobj=io.BytesIO(data), mode="r:")
        members = archive.getmembers()
    except (tarfile.TarError, EOFError, OSError):
        raise Refusal("the archive of the project files is not a tar") from None
    found = {}
    with archive:
        for member in members:
            name = member.name.rstrip("/")
            if member.isdir() and name in PARENTS:
                continue
            if name not in STAGED:
                raise Refusal(f"unexpected path in the archive of the project files: {name[:80]} (only {', '.join(STAGED)} are read)")
            if not member.isreg():
                raise Refusal(f"{name} is not a regular file in the project (a link or a special file is refused)")
            if member.size > MAX_FILE:
                raise Refusal(f"{name} is larger than {MAX_FILE} bytes")
            if STAGED[name] in found:
                raise Refusal(f"{name} appears twice in the archive")
            try:
                found[STAGED[name]] = archive.extractfile(member).read().decode("utf-8")
            except (OSError, UnicodeDecodeError):
                raise Refusal(f"{name} cannot be read as UTF-8 text") from None
    return found


# ------------------------------------------------------------------------------------------------------------ git
def run_command(argv, env=None, input=None):
    try:
        done = subprocess.run(list(argv), env=env, input=input, capture_output=True, timeout=900, check=False)
    except FileNotFoundError:
        return 127, b"", b"command not found"
    except subprocess.TimeoutExpired:
        return 124, b"", b"timed out"
    return done.returncode, done.stdout, done.stderr


def _git(args, repo, user, run):
    """Run git on REPO (a path), as USER when given (the AI user's clone: git, its config, and its hooks run as that account)."""
    prefix = [GIT, "-C", repo]
    if user:
        env = [f"{key}={value}" for key, value in GIT_ENV.items()]
        return run(["runuser", "-u", user, "--", "/usr/bin/env", "-i", *env, *prefix, *args], None, None)
    return run([*prefix, *args], dict(GIT_ENV), None)


def _archive(repo, user, commit, run):
    """The tar of the three paths at COMMIT (those that exist), through git archive."""
    code, out, _ = _git(["ls-tree", "-r", "-z", "--name-only", commit, "--", *STAGED], repo, user, run)
    if code != 0:
        raise Refusal("the project files cannot be listed at that commit")
    present = [name for name in out.decode("utf-8", "replace").split("\0") if name in STAGED]
    if not present:
        return _empty_tar()
    code, data, _ = _git(["archive", "--format=tar", commit, "--", *present], repo, user, run)
    if code != 0:
        raise Refusal("git archive failed for the project files")
    return data


def _commit_of(repo, user, revision, run):
    code, out, _ = _git(["rev-parse", "--verify", "--quiet", "--end-of-options", f"{revision}^{{commit}}"], repo, user, run)
    commit = out.decode().strip()
    return commit if code == 0 and SHA.fullmatch(commit) else None


def clone_bare(url, dest):
    """An anonymous bare clone over https. The address is checked by the caller; no credential is passed or read."""
    done = subprocess.run([GIT, "-c", "protocol.allow=never", "-c", "protocol.https.allow=always", "-c", "credential.helper=",
                           "clone", "--quiet", "--bare", "--", url, dest], env=dict(GIT_ENV), capture_output=True, timeout=900, check=False)
    if done.returncode != 0:
        raise Refusal("the anonymous clone failed (is the repository public, and is the address right?)")


def fetch_anonymous(url, ref, workdir, clone=clone_bare, run=run_command):
    """(commit, tar) of a tag or full SHA of an anonymous clone; the commit must be merged (reachable from the default branch)."""
    found = URL.fullmatch(url or "")
    if not found or found.group(1) in (".", "..") or found.group(2) in (".", ".."):
        raise Refusal("the project address must be an anonymous https://github.com/<owner>/<repository> address")
    if not (SHA.fullmatch(ref or "") or TAG.fullmatch(ref or "")):
        raise Refusal("the reference must be a tag name or a full 40-character commit SHA")
    scratch = tempfile.mkdtemp(prefix=".clone-", dir=workdir)
    try:
        repo = os.path.join(scratch, "repo.git")
        clone(url, repo)
        if SHA.fullmatch(ref):
            commit = _commit_of(repo, None, ref, run)
        else:
            commit = _commit_of(repo, None, f"refs/tags/{ref}", run)
        if not commit:
            raise Refusal(f"{ref} is neither a tag of the project nor a commit in its clone")
        code, _, _ = _git(["merge-base", "--is-ancestor", commit, "HEAD"], repo, None, run)
        if code == 1:
            raise Refusal(f"{ref} ({commit[:12]}) is not merged: it is not reachable from the default branch")
        if code != 0:
            raise Refusal("cannot tell whether the commit is merged")
        return commit, _archive(repo, None, commit, run)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def fetch_supplied(clone_path, sha, user, run=run_command):
    """(commit, tar) of a full SHA in the AI user's clone. The SHA is the user's choice: merged or not."""
    if not SHA.fullmatch(sha or ""):
        raise Refusal("the supplied SHA must be a full 40-character lowercase commit SHA")
    if not clone_path or not os.path.isabs(clone_path):
        raise Refusal("the clone must be given as an absolute path")
    commit = _commit_of(clone_path, user or None, sha, run)
    if commit != sha:
        raise Refusal(f"the clone has no commit {sha[:12]}")
    return commit, _archive(clone_path, user or None, commit, run)


# ------------------------------------------------------------------------------------------------------------ the record
def read_recorded(directory):
    """(deny text, commit) that an earlier lab setup recorded, or (None, None). A link or a file of another owner is refused."""
    if not directory or not os.path.isdir(directory):
        return None, None
    texts = {}
    for name in ("deny.platform.txt", "SOURCE"):
        path = os.path.join(directory, name)
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        except FileNotFoundError:
            continue
        except OSError:
            raise Refusal(f"the recorded {name} cannot be opened (a link is refused)") from None
        with os.fdopen(fd, "rb") as handle:
            info = os.fstat(handle.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid not in (0, os.getuid()) or info.st_size > MAX_FILE:
                raise Refusal(f"the recorded {name} is not a regular file of root")
            texts[name] = handle.read().decode("utf-8", "replace")
    if "deny.platform.txt" not in texts:
        return None, None
    commit = next((line[7:] for line in texts.get("SOURCE", "").splitlines() if line.startswith("commit=")), "")
    return texts["deny.platform.txt"], commit or None


def _write_new(path, text):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(text)


def _digest(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest() if text is not None else "none"


def stage(args, clone=clone_bare, run=run_command):
    """The result dictionary of the stage command; stages the files only when every check has passed."""
    with open(args.core, "rb") as handle:
        core_text = handle.read(MAX_FILE).decode("utf-8")
    result = {"source": None, "manifest_present": False, "manifest_skipped": [], "packages": [], "package_list_present": False}
    files, project_deny, commit, label = {}, None, None, None
    if args.repo:
        commit, data = fetch_anonymous(args.repo, args.ref, args.out, clone=clone, run=run)
        result["source"] = {"kind": "anonymous", "commit": commit, "repo": args.repo, "ref": args.ref}
        label = "/".join(args.repo.split("/")[-2:])
    elif args.sha:
        commit, data = fetch_supplied(args.clone, args.sha, args.as_user, run=run)
        result["source"] = {"kind": "supplied-sha", "commit": commit, "repo": None, "ref": None}
    else:
        data = None
        recorded, recorded_commit = read_recorded(args.recorded)
        if recorded is not None:
            parse_deny(recorded)
            project_deny = recorded
            result["source"] = {"kind": "recorded", "commit": recorded_commit, "repo": None, "ref": None}
    if data is not None:
        files = extract_tar(data)
        if "manifest.toml" in files:
            original = files["manifest.toml"]
            reduced, skipped = filter_manifest(original)
            result["manifest_skipped"] = [list(item) for item in skipped]
            if reduced is None:
                del files["manifest.toml"]
            else:
                files["manifest.toml"] = reduced
            result["manifest_original_sha256"] = _digest(original)
        result["manifest_present"] = "manifest.toml" in files
        if "packages.txt" in files:
            result["packages"] = parse_packages(files["packages.txt"])
            result["package_list_present"] = True
        project_deny = files.get("deny.platform.txt")
    text, entries, added = merge_deny(core_text, project_deny, label, commit or (result["source"] or {}).get("commit"))
    result.update({"deny_text": text, "deny_entries": entries, "added": added,
                   "manifest_text": files.get("manifest.toml"), "packages_text": files.get("packages.txt"),
                   "deny_platform_text": project_deny})
    if result["source"] and result["source"]["kind"] != "recorded":
        source = result["source"]
        result["source_text"] = (
            "# Written by lab setup (ansible/roles/lab_project). Do not edit.\n"
            f"kind={source['kind']}\nrepo={source['repo'] or ''}\nref={source['ref'] or ''}\ncommit={source['commit']}\n"
            f"manifest_sha256={result.get('manifest_original_sha256', 'none')}\npackages_sha256={_digest(files.get('packages.txt'))}\n"
            f"deny_platform_sha256={_digest(files.get('deny.platform.txt'))}\n")
    else:
        result["source_text"] = None
    for name, text_of in files.items():
        _write_new(os.path.join(args.out, name), text_of)
    return result


# ------------------------------------------------------------------------------------------------------------ packages
def plan_packages(names, run=run_command):
    """[(name, version, origins)] of the apt simulation for NAMES, sorted by name. Refuses a plan that removes a package or takes one
    from anywhere but the Debian archive."""
    code, out, _ = run(["apt-get", "-s", "install", "--no-install-recommends", "--", *names], dict(APT_ENV), None)
    text = out.decode("utf-8", "replace")
    if code != 0:
        problem = next((line for line in text.splitlines() if line.startswith("E:")), "apt-get could not simulate the install")
        hint = " (is the package index empty or old on this machine? run `apt-get update` as root first)" if "Unable to locate" in text else ""
        raise Refusal(f"apt cannot plan the package list: {problem[:160]}{hint}")
    plan = []
    for line in text.splitlines():
        if line.startswith(("Remv ", "Purg ")):
            raise Refusal(f"the plan would remove a package ({line[:80]}); a project package list only installs")
        found = INST.match(line)
        if not found:
            continue
        name, version, origins = found.groups()
        tokens = [token.strip() for token in origins.split(",")]
        for token in tokens:
            if not token.startswith(("Debian:", "Debian-Security:")):
                raise Refusal(f"{name} {version} comes from {token}, which is not the Debian archive")
        plan.append((name, version, ",".join(tokens)))
    return sorted(plan)


def plan_digest(plan):
    lines = sorted({f"{name} {version}" for name, version, _ in plan})
    return hashlib.sha256("\n".join(lines).encode("utf-8")).hexdigest()


def report_packages(names, apply, reviewed, run, out):
    plan = plan_packages(names, run=run)
    digest = plan_digest(plan)
    print(f"lab-project: package list of {len(names)} name(s); apt would install {len(plan)} package(s) from the Debian archive "
          "(dependencies included, as of the package index on this machine)", file=out)
    for name, version, origin in plan:
        print(f"{name} {version} {origin}", file=out)
    print(f"plan_sha256={digest}", file=out)
    if not apply or not plan:
        print(f"changed={len(plan)}", file=out)
        return 0
    if reviewed is None or reviewed == "":
        print("refused: the package list is applied only after the dry run was read. Run lab setup with --check --diff, read the list "
              "above, and pass -e lab_project_packages_reviewed=<the plan_sha256 of that dry run>.", file=out)
        return 1
    if reviewed != digest:
        print(f"refused: the plan changed since the dry run that was read (reviewed {reviewed[:12]}, now {digest[:12]}). Run the dry "
              "run again and read it.", file=out)
        return 1
    code, output, _ = run(["apt-get", "install", "-y", "--no-install-recommends", "--", *names], dict(APT_ENV), None)
    if code != 0:
        tail = output.decode("utf-8", "replace").strip().splitlines()[-3:]
        print("refused: apt-get install failed: " + " | ".join(tail)[:300], file=out)
        return 1
    print(f"changed={len(plan)}", file=out)
    return 0


# ------------------------------------------------------------------------------------------------------------ command line
class _Parser(argparse.ArgumentParser):
    def error(self, message):
        raise SystemExit(_usage(message))


def _usage(message):
    print(f"lab-project-input: usage error: {message}", file=sys.stderr)
    return 2


def _parser():
    parser = _Parser(prog="lab-project-input", add_help=False)
    sub = parser.add_subparsers(dest="command", required=True, parser_class=_Parser)
    st = sub.add_parser("stage")
    st.add_argument("--out", required=True)
    st.add_argument("--core", required=True)
    st.add_argument("--repo", default="")
    st.add_argument("--ref", default="")
    st.add_argument("--clone", default="")
    st.add_argument("--sha", default="")
    st.add_argument("--as-user", default="")
    st.add_argument("--recorded", default="")
    pk = sub.add_parser("packages")
    pk.add_argument("--file", required=True)
    pk.add_argument("--apply", action="store_true")
    pk.add_argument("--reviewed", default=None)
    return parser


def main(argv=None, out=None, err=None, clone=clone_bare, run=run_command):
    out, err = out or sys.stdout, err or sys.stderr
    try:
        args = _parser().parse_args(sys.argv[1:] if argv is None else argv)
    except SystemExit as stop:
        return stop.code if isinstance(stop.code, int) else 2
    try:
        if args.command == "packages":
            with open(args.file, "rb") as handle:
                names = parse_packages(handle.read(MAX_FILE).decode("utf-8"))
            return report_packages(names, args.apply, args.reviewed, run, out)
        if bool(args.repo) != bool(args.ref) or bool(args.clone) != bool(args.sha) or (args.repo and args.clone):
            print("lab-project-input: usage error: give --repo with --ref, or --clone with --sha, and not both", file=err)
            return 2
        result = stage(args, clone=clone, run=run)
    except Refusal as refusal:
        print(f"lab-project-input: refused: {refusal}", file=err)
        return 1
    except (OSError, UnicodeDecodeError) as error:
        print(f"lab-project-input: refused: {type(error).__name__}: {error}", file=err)
        return 1
    print(json.dumps(result, sort_keys=True), file=out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
