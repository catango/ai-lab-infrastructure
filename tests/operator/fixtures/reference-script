#!/usr/bin/env python3
"""A reference operator script for the tests: one step, dry run by default."""
import os
import sys

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "..", "..", "scripts", "operator", "lib"))

from operator_lib import modes, steps  # noqa: E402


def main(argv):
    mode, _ = modes.parse_mode(argv, "reference-script", "Reference operator script.")
    marker = os.path.join(os.getcwd(), "marker")

    def create():
        with open(marker, "w", encoding="utf-8") as handle:
            handle.write("x")

    plan = [steps.Step("create the marker", lambda: not os.path.exists(marker), create)]
    steps.run_steps(plan, mode, out=print)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
